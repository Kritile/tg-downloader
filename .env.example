# Telegram Bot / Local Bot API
BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Base URL inside the Docker internal network.
TELEGRAM_API_URL=http://telegram-bot-api:8081

# MAX Messenger Bot (optional)
MAX_BOT_TOKEN=your_max_bot_token_here

# Database
DATABASE_URL=postgres://postgres:postgres@postgres:5432/mediaharvester?sslmode=disable

# Redis
REDIS_URL=redis://redis:6379/0

# Global Limits
GLOBAL_DEFAULT_DAILY_LIMIT=10
GLOBAL_DEFAULT_MONTHLY_LIMIT=100

# Worker Configuration
WORKER_COUNT=3

# Admin Panel
ADMIN_PORT=8080
SESSION_SECRET=your_session_secret_here_change_in_production

# SOCKS5 proxy for yt-dlp YouTube traffic only.
# MAX and Telegram API requests bypass this proxy.
# Format: username:password@host:port, host:port, or socks5://username:password@host:port
XRAY_SOCKS5_PROXY=host:10808
